# Variáveis de runtime da função. Em produção: UI do Netlify (Project configuration > Environment variables),
# escopo "Functions", marcadas como secret. NÃO ficam no netlify.toml (lá só chegam ao build).

# Segredo de assinatura dos tokens (mín. 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Quem recebe o aviso de novo cadastro. Nunca é enviado ao navegador.
ADMIN_EMAIL=

# Envio de e-mail pelo Resend (https://resend.com). Sem domínio verificado, o remetente de teste
# (onboarding@resend.dev) só entrega para o e-mail da própria conta Resend.
RESEND_API_KEY=
MAIL_FROM=

# URL pública do site, usada nos links do e-mail de aprovação (https, sem barra no final).
SITE_URL=

# ---- Só no PC (arquivo .env local, ignorado pelo git). NÃO crie estas no Netlify. ----

# Token do TMDB para `npm run atualizar-catalogo`: "API Read Access Token" em themoviedb.org > Settings > API.
TMDB_TOKEN=

# Só para desenvolvimento local com `netlify dev` (imprime os links no console em vez de enviar e-mail).
# Ignorado fora do netlify dev. Não configure em produção.
# MAIL_DRY_RUN=1
